      "level_interval": [19, 100],
      "additional_text": "Shield: resistances, life, increased block."
    },
    {
      "inventory_id": "BodyArmour1",
      "level_interval": [20, 100],
      "additional_text": "Spirit for different active reviving minion types, then resistances / life / ES. Do not assume every minion fits immediately."
    },
