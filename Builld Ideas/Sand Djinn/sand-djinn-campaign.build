    {
      "id": "Metadata/Items/Gem/SkillGemAscendancyCommandSandExplodeTeleport",
      "level_interval": [19, 100],
      "additional_text": "<b>{Kelari's Deception}\nFIRST ASCENDANCY REQUIRED: level 19 is GuyThatDies's swap checkpoint, not an automatic unlock. Granted by the Kelari ascendancy setup, not cut. [1] Bidding; [2] Magnified Area for clear OR Concentrated Area for bosses; [3] Muster at level 36 once the socket is available. No second Fire Djinn is prescribed by this campaign guide.\nSame-slot supports are alternatives/upgrades, not simultaneous.",
      "support_skills": [
        {
          "id": "Metadata/Items/Gems/SupportGemMagnifiedEffect",
          "level_interval": [19, 100],
          "additional_text": "Magnified Area I\nSlot [2]. T1 priority 5.\nReserve one of the last two Act 1 support rewards for the Djinn swap; replaces Concentrated Area for clear."
        },
        {
          "id": "Metadata/Items/Gems/SupportGemConcentratedEffect",
          "level_interval": [19, 100],
          "additional_text": "Concentrated Area\nSlot [2]. T1 priority 6.\nReserve the other Act 1 support for the Djinn swap; replaces Magnified Area for bosses. Never use both together."
        },
        {
          "id": "Metadata/Items/Gem/SupportGemBidding",
          "level_interval": [19, 100],
          "additional_text": "Bidding I\nSlot [1]. T2 priority 1.\nSource reward order: Vastiri Outskirts, Raided Camp. Save for the Djinn swap."
        },
        {
          "id": "Metadata/Items/Gems/SupportGemMagnifiedEffectTwo",
          "level_interval": [31, 100],
          "additional_text": "Magnified Area II\nSlot [2]. T3 priority 1.\nSource order: Sandswept Marsh league-mechanic reward, if present. Level 31 is an approximate Act 3 checkpoint, not a drop guarantee."
        },
        {
          "id": "Metadata/Items/Gem/SupportGemMuster",
          "level_interval": [36, 100],
          "additional_text": "Muster\nSlot [3]. T3 priority 2.\nSource order: Venom Crypts sarcophagus. Equip at level 36 per the guide, once the third Djinn socket is available. Counts different active reviving minion types."
        },
        {
          "id": "Metadata/Items/Gem/SupportGemBiddingTwo",
          "level_interval": [45, 100],
          "additional_text": "Bidding II\nSlot [1]. T4 priority 1.\nSource reward: Isle of Kin, Beast Pen. Level 45 is an approximate Act 4 checkpoint; equip when the T4 support is actually available."
